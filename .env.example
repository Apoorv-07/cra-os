# ---------------------------------------------------------------------------
# CRA Compliance OS — environment reference
#
# Copy to `.env` for local development. In production, set real environment
# variables in your platform's secret store; `.env` is never read there (real
# environment variables always win, and `.env` is git-ignored).
#
# The service boots with zero configuration for local development. In
# production it refuses to start without SESSION_SECRET and ENCRYPTION_KEY.
# ---------------------------------------------------------------------------

# -- Core --------------------------------------------------------------------
NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Public URLs. APP_URL is used for callbacks and share links; WEB_URL is the
# frontend in development. In production both point at your domain.
APP_URL=http://localhost:8787
WEB_URL=http://localhost:5173

# SQLite database file. Use an absolute path in production, on a persistent
# volume. Migrations run automatically on boot.
DATABASE_PATH=data/cra.db

# -- Secrets (REQUIRED in production) ----------------------------------------
# Generate each with: openssl rand -hex 32
# SESSION_SECRET signs session cookies. Rotating it signs everyone out.
# ENCRYPTION_KEY encrypts GitHub tokens and other stored secrets. Rotating it
# makes existing encrypted values unreadable.
SESSION_SECRET=
ENCRYPTION_KEY=

# -- Storage -----------------------------------------------------------------
# local: writes to STORAGE_DIR (development and single-node deployments).
# r2:    Cloudflare R2 (see R2_* below).
STORAGE_DRIVER=local
STORAGE_DIR=data/storage

# -- Source control (GitHub App) ---------------------------------------------
# Create a GitHub App with:
#   Repository permissions: Contents (read), Metadata (read), Pull requests
#     (read+write for PR comments)
#   Organisation permissions: Members (read)
#   Events: Push, Installation, Installation repositories
#   Webhook URL: https://<your-domain>/api/v1/integrations/github/webhook
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The App private key, with literal \n sequences or a real multi-line value.
GITHUB_APP_PRIVATE_KEY=
# Generate with: openssl rand -hex 32  — must match the App's webhook secret.
GITHUB_APP_WEBHOOK_SECRET=
# Optional: GitHub OAuth for "Sign in with GitHub".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_BASE=https://api.github.com

# -- Vulnerability intelligence ----------------------------------------------
# Defaults are the public feeds. Override only if you proxy them.
OSV_URL=https://api.osv.dev
KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_URL=https://api.first.org/data/v1/epss

# -- AI (optional) -----------------------------------------------------------
# AI is used only to summarise, draft and classify existing data. It never
# invents compliance facts, and every suggestion is recorded with the source
# data it considered.
# none       — deterministic templates only (default, no cost, no keys)
# workers-ai — Cloudflare Workers AI (needs CLOUDFLARE_*)
# openai     — needs OPENAI_API_KEY
# anthropic  — needs ANTHROPIC_API_KEY
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# -- Payments ----------------------------------------------------------------
# manual — no payment provider. Credits can only be granted by an admin.
#          This is a real path, not a mock: no money is simulated.
# dodo   — Dodo Payments (merchant of record; recommended for selling into
#          the EU from outside it).
PAYMENT_PROVIDER=manual
DODO_API_KEY=
# The endpoint secret Dodo shows when you create the webhook, e.g. whsec_…
# Webhook URL: https://<your-domain>/api/v1/billing/webhooks/dodo
# Subscribe to: payment.succeeded, payment.failed, subscription.active,
#               subscription.cancelled, refund.succeeded
DODO_WEBHOOK_SECRET=
DODO_ENV=test
DODO_BASE_URL=https://live.dodopayments.com

# -- Mail --------------------------------------------------------------------
# console — prints magic links and invites to the server log (development)
# resend  — sends real mail (needs RESEND_API_KEY)
# none    — disables outbound mail
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=CRA Compliance OS <no-reply@example.com>

# -- Behaviour ---------------------------------------------------------------
# When false, nothing is charged and every action is free. Useful for a demo
# tenant; never disable billing in a deployment that takes money.
BILLING_ENABLED=true
SELF_SERVE_SIGNUP=true

# Credits granted to a new organisation. 250 covers connecting a repository,
# a few scans and one readiness report, so the free tier can complete the core
# flow without paying.
PUBLIC_SIGNUP_CREDITS=250

# Public readiness badges (GET /api/v1/badge/:token).
PUBLIC_BADGES=true

# Worker. Set RUN_WORKER_IN_PROCESS=false and run `npm run worker` as a
# separate process for anything beyond a single small deployment.
RUN_WORKER_IN_PROCESS=true
WORKER_POLL_MS=1500
WORKER_CONCURRENCY=3

# Rate limiting (per IP, per window).
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_S=60

# Comma-separated emails granted the admin console at signup.
ADMIN_EMAILS=

# Maximum uploaded archive size, in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400

# Trust X-Forwarded-For from the proxy in front of the app. Keep true behind
# Cloudflare, nginx or a platform load balancer.
TRUST_PROXY=true
