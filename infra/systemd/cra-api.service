[Unit]
Description=CRA Compliance OS API
After=network.target

[Service]
Type=simple
User=cra
Group=cra
WorkingDirectory=/opt/cra/apps/api
EnvironmentFile=/opt/cra/.env
ExecStart=/usr/bin/node /opt/cra/apps/api/dist/index.js
Restart=always
RestartSec=3
# Shut down cleanly: the worker releases in-flight reservations on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cra

[Install]
WantedBy=multi-user.target
